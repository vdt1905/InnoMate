# Copy to .env and fill in. Never commit the real .env.
PORT=5000

# development locally: auth cookies need secure=false / SameSite=Lax to work
# over http://localhost. Hosting providers set this to production themselves.
NODE_ENV=development

# MongoDB connection string (Atlas SRV URI or mongodb://127.0.0.1:27017/InnoMate)
MONGO_URI=

# Secret used to sign session JWTs — any long random string
JWT_SECRET=

# Firebase Admin credentials. Either drop config/serviceAccountKey.json in place
# or paste the whole service-account JSON into FIREBASE_SERVICE_ACCOUNT.
FIREBASE_SERVICE_ACCOUNT=

# Extra browser origin allowed through CORS (e.g. a preview deployment)
CLIENT_URL=
